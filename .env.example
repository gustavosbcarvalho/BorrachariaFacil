# =============================================================
# BORRACHARIA FÁCIL — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env
# =============================================================

# --------------------------------------------------
# SUPABASE / PostgreSQL
# --------------------------------------------------
# Transaction Pooler — porta 6543, ?pgbouncer=true
# Usado em runtime (Vercel). Suporta muitas conexões simultâneas.
# Obter em: Supabase → Settings → Database → Connection string → Transaction Pooler
DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-1-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Pooler — porta 5432
# Usado apenas para migrations e seed (prisma migrate deploy, db:seed).
# Obter em: Supabase → Settings → Database → Connection string → Session Pooler
DIRECT_URL="postgresql://postgres.[REF]:[SENHA]@aws-1-REGIAO.pooler.supabase.com:5432/postgres"

# ATENÇÃO: Se a senha tiver "/" ou "@" ou "#", encode como %2F, %40, %23

# --------------------------------------------------
# NEXTAUTH / AUTENTICAÇÃO
# --------------------------------------------------
# URL da aplicação (localhost para dev, URL do Vercel em produção)
NEXTAUTH_URL="http://localhost:3000"

# Secret seguro — gere com: openssl rand -base64 32
# Ou acesse: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="troque-por-uma-string-aleatoria-e-segura-de-32-chars"
