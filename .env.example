# =============================================================
# BORRACHARIA FÁCIL — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env
# =============================================================

# --------------------------------------------------
# SUPABASE / PostgreSQL
# --------------------------------------------------
# Porta 6543 = PgBouncer (connection pooling) — usado em runtime
DATABASE_URL="postgresql://postgres:[SENHA]@db.[REF-DO-PROJETO].supabase.co:6543/postgres?pgbouncer=true"

# Porta 5432 = conexão direta — usado em migrations e seed
DIRECT_URL="postgresql://postgres:[SENHA]@db.[REF-DO-PROJETO].supabase.co:5432/postgres"

# Como obter:
# 1. Acesse app.supabase.com → seu projeto → Settings → Database
# 2. Role até "Connection string"
# 3. Selecione "URI" e copie as duas strings (com e sem pgbouncer)

# --------------------------------------------------
# NEXTAUTH / AUTENTICAÇÃO
# --------------------------------------------------
# URL da aplicação (localhost para dev, URL do Vercel em produção)
NEXTAUTH_URL="http://localhost:3000"

# Secret seguro — gere com: openssl rand -base64 32
# Ou acesse: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="troque-por-uma-string-aleatoria-e-segura-de-32-chars"
