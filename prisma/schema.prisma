generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SYSTEM_ADMIN
  ADMIN
  OPERATOR
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  CONVENIO
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  COURTESY
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PlanStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlanName {
  FREE
  BASIC
  PRO
}

// ─── Borracharias (tenants) ───────────────────────────────────────────────────

model Borracharia {
  id                String     @id @default(cuid())
  name              String
  cnpj              String?    @unique
  cpf               String?
  address           String
  city              String
  state             String
  zipCode           String     @map("zip_code")
  timezone          String     @default("America/Sao_Paulo")
  active            Boolean    @default(true)
  planStatus        PlanStatus @default(TRIAL) @map("plan_status")
  planName          PlanName   @default(FREE) @map("plan_name")
  trialEndsAt       DateTime?  @map("trial_ends_at")
  subscriptionNotes String?    @map("subscription_notes")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  users             User[]
  services          Service[]
  expenses          Expense[]
  serviceTypes      ServiceType[]
  expenseCategories ExpenseCategory[]
  convenios         Convenio[]
  companies         Company[]

  @@map("borracharias")
}

// ─── Usuários ─────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               Role      @default(OPERATOR)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  borrachariaId      String?   @map("borracharia_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  borracharia     Borracharia? @relation(fields: [borrachariaId], references: [id])
  services        Service[]    @relation("ServiceCreatedBy")
  updatedServices Service[]    @relation("ServiceUpdatedBy")
  expenses        Expense[]    @relation("ExpenseCreatedBy")
  updatedExpenses Expense[]    @relation("ExpenseUpdatedBy")

  @@map("users")
}

// ─── Tipos de Serviço ─────────────────────────────────────────────────────────

model ServiceType {
  id            String       @id @default(cuid())
  name          String
  active        Boolean      @default(true)
  borrachariaId String?      @map("borracharia_id")

  borracharia Borracharia? @relation(fields: [borrachariaId], references: [id])
  services    Service[]

  @@unique([name, borrachariaId])
  @@map("service_types")
}

// ─── Empresas (para Convênios) ────────────────────────────────────────────────

model Company {
  id            String      @id @default(cuid())
  borrachariaId String      @map("borracharia_id")
  name          String
  cnpj          String?
  contactName   String?     @map("contact_name")
  phone         String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  borracharia Borracharia @relation(fields: [borrachariaId], references: [id])
  convenios   Convenio[]

  @@index([borrachariaId])
  @@map("companies")
}

// ─── Serviços Executados ──────────────────────────────────────────────────────

model Service {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  updatedById       String?       @map("updated_by_id")
  borrachariaId     String?       @map("borracharia_id")
  serviceTypeId     String        @map("service_type_id")
  description       String?
  vehiclePlate      String?       @map("vehicle_plate")
  amount            Decimal       @db.Decimal(10, 2)
  amountPaid        Decimal       @default(0) @db.Decimal(10, 2) @map("amount_paid")
  amountDue         Decimal       @default(0) @db.Decimal(10, 2) @map("amount_due")
  paymentMethod     PaymentMethod @map("payment_method")
  paymentStatus     PaymentStatus @default(PAID) @map("payment_status")
  convenioId        String?       @map("convenio_id")
  convenioPaymentId String?       @map("convenio_payment_id")
  notes             String?
  occurredAt        DateTime      @map("occurred_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  user            User             @relation("ServiceCreatedBy", fields: [userId], references: [id])
  updatedBy       User?            @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])
  borracharia     Borracharia?     @relation(fields: [borrachariaId], references: [id])
  serviceType     ServiceType      @relation(fields: [serviceTypeId], references: [id])
  convenio        Convenio?        @relation(fields: [convenioId], references: [id])
  convenioPayment ConvenioPayment? @relation(fields: [convenioPaymentId], references: [id])

  @@index([borrachariaId])
  @@index([occurredAt])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([convenioId])
  @@index([vehiclePlate])
  @@index([deletedAt])
  @@map("services")
}

// ─── Categorias de Despesa ────────────────────────────────────────────────────

model ExpenseCategory {
  id            String       @id @default(cuid())
  name          String
  active        Boolean      @default(true)
  borrachariaId String?      @map("borracharia_id")

  borracharia Borracharia? @relation(fields: [borrachariaId], references: [id])
  expenses    Expense[]

  @@unique([name, borrachariaId])
  @@map("expense_categories")
}

// ─── Despesas / Gastos ────────────────────────────────────────────────────────

model Expense {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  updatedById   String?         @map("updated_by_id")
  borrachariaId String?         @map("borracharia_id")
  categoryId    String          @map("category_id")
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  paymentMethod PaymentMethod   @map("payment_method")
  hasReceipt    Boolean         @default(false) @map("has_receipt")
  notes         String?
  occurredAt    DateTime        @map("occurred_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  user        User            @relation("ExpenseCreatedBy", fields: [userId], references: [id])
  updatedBy   User?           @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  borracharia Borracharia?    @relation(fields: [borrachariaId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([borrachariaId])
  @@index([occurredAt])
  @@index([paymentMethod])
  @@index([deletedAt])
  @@map("expenses")
}

// ─── Convênios ────────────────────────────────────────────────────────────────

model Convenio {
  id               String           @id @default(cuid())
  borrachariaId    String           @map("borracharia_id")
  companyId        String?          @map("company_id")
  companyName      String           @map("company_name") // mantido para dados existentes
  paymentFrequency PaymentFrequency @map("payment_frequency")
  nextPaymentDate  DateTime         @map("next_payment_date")
  active           Boolean          @default(true)
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  borracharia Borracharia      @relation(fields: [borrachariaId], references: [id])
  company     Company?         @relation(fields: [companyId], references: [id])
  services    Service[]
  payments    ConvenioPayment[]

  @@index([borrachariaId])
  @@index([deletedAt])
  @@map("convenios")
}

// ─── Pagamentos de Convênio ───────────────────────────────────────────────────

model ConvenioPayment {
  id         String   @id @default(cuid())
  convenioId String   @map("convenio_id")
  amountPaid Decimal  @db.Decimal(10, 2) @map("amount_paid")
  paidAt     DateTime @map("paid_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  convenio Convenio  @relation(fields: [convenioId], references: [id])
  services Service[]

  @@index([convenioId])
  @@map("convenio_payments")
}
